{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snaiko.github.io/arabic-font-research-prep/schemas/style_description.schema.json",
  "title": "Arabic font style description record",
  "type": "object",
  "required": ["style_id", "language_script", "source", "description", "attributes", "geometry", "glyphs", "assets", "splits"],
  "properties": {
    "style_id": {"type": "string", "minLength": 1},
    "language_script": {"type": "string", "const": "Arab"},
    "source": {
      "type": "object",
      "required": ["name", "url", "license", "training_permission", "synthetic"],
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "license": {"type": "string"},
        "training_permission": {"enum": ["approved", "denied", "unclear", "permission_required", "verify_before_use"]},
        "synthetic": {"type": "boolean"},
        "description_provenance": {"enum": ["human_reviewed", "synthetic_from_parameters", "machine_generated_unreviewed", "unknown"]},
        "evidence_url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": true
    },
    "description": {
      "type": "object",
      "properties": {"ar": {"type": "string"}, "en": {"type": "string"}},
      "anyOf": [{"required": ["ar"]}, {"required": ["en"]}],
      "additionalProperties": false
    },
    "attributes": {"type": "object", "minProperties": 1},
    "geometry": {"type": "object", "properties": {"units": {"type": "string"}, "method": {"type": "string"}, "per_glyph": {"type": "object"}, "summary": {"type": "object"}}, "required": ["units", "method"], "additionalProperties": true},
    "glyphs": {"type": "object"},
    "assets": {"type": "object"},
    "splits": {"type": "object", "required": ["group_id", "partition"], "properties": {"group_id": {"type": "string"}, "partition": {"enum": ["train", "validation", "test"]}}, "additionalProperties": true}
  },
  "additionalProperties": false
}
